# AetherGuard Configuration Template
# Copy this file to .env and provide your private values.
# NEVER commit .env files containing real secrets to version control.

# Required: Secret operator token for single-operator access control (Bearer authentication)
# Generate a secure random string (minimum 32 characters recommended)
AETHERGUARD_OPERATOR_TOKEN=replace_with_a_secure_random_operator_token_min_32_chars

# Optional: Google Gemini API key for live multimodal agent proposals
# If left empty, AetherGuard runs in high-fidelity deterministic synthetic evaluation mode
GEMINI_API_KEY=

# Server configuration
AETHERGUARD_HOST=127.0.0.1
AETHERGUARD_PORT=8000
AETHERGUARD_RATE_LIMIT_PER_MINUTE=20
AETHERGUARD_TRUSTED_PROXIES=127.0.0.1,::1

# Database path (defaults to sandbox.db in working directory or /data/sandbox.db in container)
# AETHERGUARD_DB_PATH=./sandbox.db
